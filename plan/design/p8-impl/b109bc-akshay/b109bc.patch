+
+    - name: count the leftovers (count only)
+      ansible.builtin.debug:
+        msg: "capture dir leftovers removed: {{ _left.matched }}"
+
+    - name: capture
+      block:
+        - name: "step: capture"
+          become: true
+          ansible.builtin.script:
+            cmd: >-
+              daolab-capture.py --home {{ _home | quote }} --skel {{ _skel | quote }}
+              --recipient {{ daolab_snapshot_recipient }} --out {{ _out | quote }}
+              --cap-bytes {{ daolab_snapshot_cap_bytes | int }} --age {{ _age | quote }}
+              --owner-uid {{ _owner_uid }}
+            executable: /usr/bin/python3 -I
+          register: _cap
+          changed_when: false
+          failed_when: _cap.rc not in [0, 1]
+
+        - name: the report (one JSON line, no paths)
+          ansible.builtin.set_fact:
+            _report: "{{ _cap.stdout_lines | map('trim') | select | list | last | from_json }}"
+
+        - name: the report has the contract's shape
+          ansible.builtin.assert:
