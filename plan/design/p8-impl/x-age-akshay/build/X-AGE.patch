+    (prefix / "bin").chmod(0o700)
+    assert install(kit, kit.tarballs[HOST], prefix).returncode == 0
+    p = install(kit, kit.tarballs[HOST], prefix)
+    assert p.returncode == 0, p.stderr
+    assert stat.S_IMODE((prefix / "bin").stat().st_mode) == 0o700
