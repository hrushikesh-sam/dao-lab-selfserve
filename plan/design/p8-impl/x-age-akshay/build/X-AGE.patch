+    """True when the pinned age v1.1.1 is usable (checked once per test session)."""
+    global _age_ok
+    if _age_ok is None:
+        _age_ok = all(_is_age_v111(os.environ.get(var) or default) for var, default in _AGE_TOOLS)
+    return _age_ok
