+
+    # -- snapshots (v4 §3.5) --
+    conn.execute(
+        """
+        CREATE TABLE IF NOT EXISTS snapshots (
+            id                  INTEGER PRIMARY KEY AUTOINCREMENT,
+            public_id           TEXT    NOT NULL UNIQUE              -- [design:119]; used in file and ticket names
+                                CHECK (length(public_id) = 32        -- Q-9: 32 lowercase hex, no '-'
