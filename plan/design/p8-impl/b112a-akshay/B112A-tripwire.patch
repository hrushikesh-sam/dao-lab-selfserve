+def _forbidden(tmp_path):
+    # ("lab" itself can't be listed: it is part of the class name "daolab")
+    return [TOKEN, str(PLANT_UID), str(tmp_path), "/", "vfio", "rvu_", "sshd", "nginx", "home",
