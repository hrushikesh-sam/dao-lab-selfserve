+# Shared constants
+# ============================================================================================
+def test_classes_and_format_match_the_checker(tw):
+    assert tw.CLASSES == dpu().CLASSES == tuple(dpu().mod().CLASSES)
+    assert tw.FORMAT == dpu().FORMAT == "daolab-tripwire/1"
