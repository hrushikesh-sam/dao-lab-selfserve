+                            "--root", root, "--proc", proc, "--input-fd", str(fd)],
+                           input=str(len(src)).encode() + b"\n" + src, capture_output=True,
+                           timeout=TIMEOUT, pass_fds=(fd,))
+    finally:
+        os.close(fd)
+        t.join()
+    assert_counts(r, {"tmp": 1})
