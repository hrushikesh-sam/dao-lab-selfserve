+# ============================================================================================
+# The baseline from a file descriptor (for when the script itself comes on stdin)
+# ============================================================================================
+def _fd_with(data):
+    r, w = os.pipe()
+
+    def feed():
+        with os.fdopen(w, "wb") as fh:
+            fh.write(data)
+
+    t = threading.Thread(target=feed)
+    t.start()
+    return r, t
