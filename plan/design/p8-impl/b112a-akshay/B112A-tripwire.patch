+    ADD["tmp"](root, proc)
+    with open(_script(), "rb") as fh:
+        src = fh.read()
+    boot = ("import sys\n"
+            "n = int(sys.stdin.buffer.readline())\n"
+            "code = compile(sys.stdin.buffer.read(n), 'daolab-tripwire', 'exec')\n"
+            "exec(code, {'__name__': '__main__'})\n")
+    fd, t = _fd_with(_bytes(base))
