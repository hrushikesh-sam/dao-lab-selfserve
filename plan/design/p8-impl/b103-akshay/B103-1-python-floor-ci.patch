+on Python 3.10 and are not covered here."""
 import importlib.metadata
 import os
 import re
+import sys
 import tomllib
 
 import pytest
+import yaml
 
 from tests.conftest import REPO
 
 FLOOR = (2, 20)
+PYTHON_FLOOR = (3, 12)
+CI_PYTHONS = ["3.12", "3.13"]
 
 
-def _ansible_pin():
+def _pyproject():
     with open(os.path.join(REPO, "pyproject.toml"), "rb") as fh:
