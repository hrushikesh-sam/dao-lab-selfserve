+    else, a lone CR, NEL, U+2028, ..., stays in its line and fails `ssh_key_line_ok`); spaces and
+    tabs around a line are dropped."""
+    out = (ln.strip(" \t") for ln in re.split(r"\r?\n", blob))
+    return [ln for ln in out if ln]
+
+
