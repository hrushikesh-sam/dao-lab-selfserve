DAOLAB_DB_PATH=./daolab.db
DAOLAB_API_HOST=0.0.0.0
DAOLAB_API_PORT=8080
DAOLAB_API_URL=http://localhost:8080
DAOLAB_TOKEN=
DAOLAB_INTERNAL_SECRET=
DAOLAB_AUTHZ_SECRET=
DAOLAB_USECASES_DIR=./usecases
DAOLAB_SETUPS_DIR=./setups
DAOLAB_INVENTORY=./inventory/hosts.yml
DAOLAB_PLAYBOOKS_DIR=./playbooks
DAOLAB_ARTIFACTS_DIR=./var/jobs
DAOLAB_DASHBOARD_DIR=./dashboard
DAOLAB_HW_CLASS_LEAD_MIN=15
DAOLAB_PROVISION_LEAD_MIN=5
DAOLAB_ENGINE_INTERVAL_SEC=60
DAOLAB_MAX_RETRIES=3
DAOLAB_SCHED_HORIZON_HOURS=168
DAOLAB_WEBHOOK_URL=
DAOLAB_LOG_LEVEL=INFO
DAOLAB_RUNNER=ansible
# The VPP / SmartNIC runbook playbooks stop nginx-tls, rebind PCI devices and set hugepages on a
# shared board; they refuse unless this is true (owner sign-off for dashboard deploys).
DAOLAB_ALLOW_DESTRUCTIVE=false
# Create the use cases' VMs on the XCP-ng host (needs it in inventory/hosts.yml).
DAOLAB_DEPLOY_VMS=false
DAOLAB_SLOT_MIN=30
DAOLAB_CLEANUP_MIN=10
DAOLAB_DEFAULT_HOURS=1
DAOLAB_IP_POOL=10.30.0.100-10.30.0.199
DAOLAB_EARLY_ACCESS=false
DAOLAB_HEALTH_STALE_SEC=120
DAOLAB_OTEL_ENDPOINT=
DAOLAB_OTEL_AGENT_ENDPOINT=
DAOLAB_PROMETHEUS_URL=http://localhost:9090
DAOLAB_MAX_LIVE_RESERVATIONS=1
DAOLAB_MAX_FUTURE_RESERVATIONS=2
DAOLAB_MOCK_STEP_SEC=5
DAOLAB_MOCK_FAIL=
DAOLAB_JOB_TIMEOUT_SEC=1800
DAOLAB_RECONCILE_ATTEMPTS=2
